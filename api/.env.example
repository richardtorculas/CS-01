# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgresql+psycopg://ugnay:ugnay@localhost:5432/ugnay
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
EMAIL_VERIFICATION_HOURS=24
# Deep link the mobile app handles; the verification token is appended as ?token=...
VERIFICATION_LINK_BASE=ugnay://verify-email
# Leave BREVO_API_KEY empty in development: verification emails are then skipped (nothing is logged).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=UGNAY
